# ──────────────────────────────────────────────
# Data containers
# ──────────────────────────────────────────────

@dataclass(frozen=True)
class Match:
    person_id: Optional[int]
    name: str
    score: float          # 0–1, ensemble confidence
    quality: float        # face-quality score 0–1
    method: str = "ensemble"


@dataclass
class GalleryEntry:
    person_id: int
    name: str
    mean_vec: np.ndarray          # L2-normalised centroid
    all_vecs: List[np.ndarray]    # every stored embedding
    cov_inv: Optional[np.ndarray] = None   # for Mahalanobis (set after build)
    adaptive_threshold: float = 0.72


# ──────────────────────────────────────────────
# Quality assessment
# ──────────────────────────────────────────────

class FaceQualityEstimator:
    """Lightweight, no-model quality filter."""

    def __call__(self, face_gray: np.ndarray) -> float:
        """Return quality score in [0, 1].  Rejects blur, extreme exposure."""
        # Sharpness via Laplacian variance (higher = sharper)
        lap_var = cv2.Laplacian(face_gray, cv2.CV_64F).var()
        sharpness = float(np.clip(lap_var / 500.0, 0.0, 1.0))   # 500 = empirical good-frame ref

        # Exposure: penalise near-black or near-white means
        mean_px = face_gray.mean() / 255.0
        exposure = 1.0 - abs(mean_px - 0.5) * 2.0               # peaks at 0.5 (mid-grey)

        # Contrast: std dev of pixel intensities
        contrast = float(np.clip(face_gray.std() / 64.0, 0.0, 1.0))  # 64 = reasonable std

        quality = 0.50 * sharpness + 0.30 * exposure + 0.20 * contrast
        return float(np.clip(quality, 0.0, 1.0))


# ──────────────────────────────────────────────
# Preprocessing
# ──────────────────────────────────────────────

class FacePreprocessor:
    """CLAHE + z-score — far more robust than raw /255."""

    def __init__(self, target_size: int = 112):
        self.target_size = target_size
        self.clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))

    def __call__(self, face: np.ndarray) -> Tuple[torch.Tensor, np.ndarray]:
        """Returns (tensor [1,1,H,W] float32), gray uint8 for quality check."""
        gray = cv2.cvtColor(face, cv2.COLOR_BGR2GRAY) if face.ndim == 3 else face.copy()
        gray = cv2.resize(gray, (self.target_size, self.target_size),
                          interpolation=cv2.INTER_AREA)
        enhanced = self.clahe.apply(gray)

        # z-score normalisation per image
        arr = enhanced.astype(np.float32)
        mu, sigma = arr.mean(), arr.std() + 1e-6
        arr = (arr - mu) / sigma

        tensor = torch.from_numpy(arr)[None, None]   # (1,1,H,W)
        return tensor, gray


# ──────────────────────────────────────────────
# Temporal vote buffer
# ──────────────────────────────────────────────

class TemporalSmoother:
    """Sliding-window majority vote with score averaging."""

    def __init__(self, window: int = 7, min_votes: int = 4):
        self.window = window
        self.min_votes = min_votes
        self._buf: Deque[Match] = deque(maxlen=window)

    def push(self, match: Match) -> Match:
        self._buf.append(match)
        return self._decide()

    def _decide(self) -> Match:
        if len(self._buf) < self.min_votes:
            return self._buf[-1]

        # Count votes per person_id
        vote_scores: Dict[Optional[int], List[float]] = defaultdict(list)
        vote_names: Dict[Optional[int], str] = {}
        for m in self._buf:
            vote_scores[m.person_id].append(m.score)
            vote_names[m.person_id] = m.name

        # Winner = most votes, ties broken by mean score
        winner_id = max(
            vote_scores,
            key=lambda pid: (len(vote_scores[pid]), np.mean(vote_scores[pid]))
        )
        mean_score = float(np.mean(vote_scores[winner_id]))
        return Match(
            person_id=winner_id,
            name=vote_names[winner_id],
            score=mean_score,
            quality=self._buf[-1].quality,
            method="temporal_vote",
        )

    def reset(self) -> None:
        self._buf.clear()


# ──────────────────────────────────────────────
# Core recognizer
# ──────────────────────────────────────────────

class LiveRecognizer:
    """
    Ensemble face recognizer targeting 85–90 % confidence on clean frames.

    Improvements over baseline
    --------------------------
    * CLAHE + z-score preprocessing
    * Quality gate — skips blurry / over-/under-exposed frames
    * Per-person centroid embedding (mean of all stored vectors)
    * Ensemble score: cosine + euclidean + Mahalanobis (when ≥3 embeddings)
    * Margin enforcement: top-1 vs top-2 gap must exceed `margin_threshold`
    * Adaptive per-class threshold derived from intra-class variance
    * Temporal sliding-window vote (7 frames, 4 votes needed)
    * Optional FAISS ANN index for large galleries (>500 identities)
    """

    def __init__(
        self,
        db: SurvilDB,
        checkpoint: str | Path,
        threshold: float = 0.72,
        quality_threshold: float = 0.45,
        margin_threshold: float = 0.08,
        temporal_window: int = 7,
        use_faiss: bool = False,
    ):
        self.db = db
        self.base_threshold = float(threshold)
        self.quality_threshold = float(quality_threshold)
        self.margin_threshold = float(margin_threshold)
        self.use_faiss = use_faiss

        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.model = (
            SurvilFaceNet.from_checkpoint(str(checkpoint), map_location=str(self.device))
            .to(self.device)
        )
        self.model.eval()
        logger.info("Model loaded on %s", self.device)

        self.preprocessor = FacePreprocessor()
        self.quality_estimator = FaceQualityEstimator()
        self.smoother = TemporalSmoother(window=temporal_window, min_votes=temporal_window // 2 + 1)

        self.gallery: List[GalleryEntry] = []
        self._faiss_index = None
        self._faiss_id_map: List[int] = []   # faiss row → gallery index

        self.reload_gallery()

    # ── Gallery management ──────────────────────────────────────────────

    def reload_gallery(self) -> None:
        self.gallery.clear()
        self.smoother.reset()

        with self.db.connect() as conn:
            rows = conn.execute(
                """SELECT p.id, p.name, e.embedding, e.dimension
                   FROM people p
                   JOIN face_embeddings e ON e.person_id = p.id
                   WHERE p.active = 1
                   ORDER BY p.id"""
            ).fetchall()

        # Group by person
        person_vecs: Dict[int, Tuple[str, List[np.ndarray]]] = {}
        for row in rows:
            vec = np.frombuffer(row["embedding"], dtype=np.float32).copy()
            if vec.size != int(row["dimension"]):
                logger.warning("Embedding dimension mismatch for person %s — skipped", row["id"])
                continue
            vec = self._l2_norm(vec)
            pid = int(row["id"])
            if pid not in person_vecs:
                person_vecs[pid] = (str(row["name"]), [])
            person_vecs[pid][1].append(vec)

        for pid, (name, vecs) in person_vecs.items():
            mean_vec = self._l2_norm(np.mean(vecs, axis=0))
            entry = GalleryEntry(
                person_id=pid,
                name=name,
                mean_vec=mean_vec,
                all_vecs=vecs,
            )
            # Adaptive threshold: tighter when intra-class variance is low
            if len(vecs) >= 2:
                intra_sims = [float(np.dot(mean_vec, v)) for v in vecs]
                entry.adaptive_threshold = max(
                    self.base_threshold,
                    float(np.mean(intra_sims)) - 2.0 * float(np.std(intra_sims)),
                )
            else:
                entry.adaptive_threshold = self.base_threshold

            # Mahalanobis inverse-covariance (needs ≥ d+1 samples, min 3)
            if len(vecs) >= 3:
                mat = np.stack(vecs)   # (N, D)
                cov = np.cov(mat, rowvar=False) + 1e-6 * np.eye(mat.shape[1])
                try:
                    entry.cov_inv = np.linalg.inv(cov)
                except np.linalg.LinAlgError:
                    entry.cov_inv = None

            self.gallery.append(entry)

        logger.info("Gallery loaded: %d identities, %d total embeddings",
                    len(self.gallery), sum(len(e.all_vecs) for e in self.gallery))

        if self.use_faiss and self.gallery:
            self._build_faiss()

    def _build_faiss(self) -> None:
        try:
            import faiss  # optional dependency
            dim = self.gallery[0].mean_vec.size
            index = faiss.IndexFlatIP(dim)  # inner-product on normalised vecs = cosine
            vecs = np.stack([e.mean_vec for e in self.gallery]).astype(np.float32)
            index.add(vecs)
            self._faiss_index = index
            self._faiss_id_map = list(range(len(self.gallery)))
            logger.info("FAISS index built (%d vectors, dim %d)", len(self.gallery), dim)
        except ImportError:
            logger.warning("faiss not installed — falling back to linear scan")
            self._faiss_index = None

    # ── Embedding ───────────────────────────────────────────────────────

    @staticmethod
    def _l2_norm(v: np.ndarray) -> np.ndarray:
        return v / max(float(np.linalg.norm(v)), 1e-12)

    @torch.inference_mode()
    def embed(self, face: np.ndarray) -> Tuple[np.ndarray, float]:
        """Return (L2-normalised embedding, quality_score)."""
        tensor, gray = self.preprocessor(face)
        quality = self.quality_estimator(gray)

        tensor = tensor.to(self.device)
        vec = self.model(tensor, classify=False)[0].cpu().numpy().astype(np.float32)
        return self._l2_norm(vec), quality

    # ── Scoring ─────────────────────────────────────────────────────────

    def _cosine(self, q: np.ndarray, g: np.ndarray) -> float:
        return float(np.dot(q, g))   # both L2-normalised

    def _euclidean_sim(self, q: np.ndarray, g: np.ndarray) -> float:
        dist = float(np.linalg.norm(q - g))
        return float(np.exp(-dist))  # maps [0, ∞) → (0, 1]

    def _mahalanobis_sim(
        self, q: np.ndarray, entry: GalleryEntry
    ) -> Optional[float]:
        if entry.cov_inv is None:
            return None
        diff = q - entry.mean_vec
        mah2 = float(diff @ entry.cov_inv @ diff)
        return float(np.exp(-0.5 * mah2))

    def _ensemble_score(self, query: np.ndarray, entry: GalleryEntry) -> float:
        cos = self._cosine(query, entry.mean_vec)
        euc = self._euclidean_sim(query, entry.mean_vec)
        mah = self._mahalanobis_sim(query, entry)

        if mah is not None:
            # All three: 50 % cosine, 30 % euclidean, 20 % Mahalanobis
            score = 0.50 * cos + 0.30 * euc + 0.20 * mah
        else:
            score = 0.60 * cos + 0.40 * euc
        return float(np.clip(score, 0.0, 1.0))

    # ── Matching ─────────────────────────────────────────────────────────

    def _linear_match(self, query: np.ndarray) -> Tuple[GalleryEntry, float, float]:
        """Return (best_entry, best_score, second_best_score)."""
        scores = [(e, self._ensemble_score(query, e)) for e in self.gallery]
        scores.sort(key=lambda x: x[1], reverse=True)
        best_entry, best_score = scores[0]
        second_score = scores[1][1] if len(scores) > 1 else 0.0
        return best_entry, best_score, second_score

    def _faiss_match(self, query: np.ndarray) -> Tuple[GalleryEntry, float, float]:
        q = query[None].astype(np.float32)
        k = min(2, len(self.gallery))
        sims, idxs = self._faiss_index.search(q, k)
        best_entry = self.gallery[int(idxs[0][0])]
        best_score = float(sims[0][0])
        second_score = float(sims[0][1]) if k > 1 else 0.0
        # Re-score with full ensemble for top candidate
        best_score = self._ensemble_score(query, best_entry)
        return best_entry, best_score, second_score

    def match(self, face: np.ndarray) -> Match:
        """
        Main recognition entry point with detailed debug output.
        """

        if not self.gallery:
            print("[RECOGNITION DEBUG] Gallery is EMPTY", flush=True)
            return Match(None, "Unknown", 0.0, 0.0, "no_gallery")

        query, quality = self.embed(face)

        print(
            f"[RECOGNITION DEBUG] quality={quality:.3f} "
            f"quality_threshold={self.quality_threshold:.3f}",
            flush=True,
        )

        # ── Quality gate ──────────────────────────────────────────────
        if quality < self.quality_threshold:
            print(
                "[RECOGNITION DEBUG] REJECTED: quality gate",
                flush=True,
            )
            last = self.smoother._buf[-1] if self.smoother._buf else None
            return last or Match(
                None,
                "Unknown",
                0.0,
                quality,
                "quality_rejected",
            )

        # ── Retrieve best match ───────────────────────────────────────
        if self._faiss_index is not None:
            entry, score, second_score = self._faiss_match(query)
        else:
            entry, score, second_score = self._linear_match(query)

        margin = score - second_score

        print(
            f"[RECOGNITION DEBUG] name={entry.name} "
            f"score={score:.4f} "
            f"adaptive_threshold={entry.adaptive_threshold:.4f} "
            f"second={second_score:.4f} "
            f"margin={margin:.4f}",
            flush=True,
        )

        # ── Decision ──────────────────────────────────────────────────
        if margin < self.margin_threshold and len(self.gallery) > 1:
            print(
                "[RECOGNITION DEBUG] REJECTED: margin",
                flush=True,
            )
            raw = Match(
                None,
                "Unknown",
                score,
                quality,
                "margin_rejected",
            )

        elif score < entry.adaptive_threshold:
            print(
                "[RECOGNITION DEBUG] REJECTED: similarity threshold",
                flush=True,
            )
            raw = Match(
                None,
                "Unknown",
                score,
                quality,
                "score_rejected",
            )

        else:
            print(
                f"[RECOGNITION DEBUG] ACCEPTED: {entry.name}",
                flush=True,
            )
            raw = Match(
                entry.person_id,
                entry.name,
                score,
                quality,
                "ensemble",
            )

        # ── Temporal smoothing ────────────────────────────────────────
        result = self.smoother.push(raw)

        print(
            f"[RECOGNITION DEBUG] FINAL={result.name} "
            f"score={result.score:.4f} method={result.method}",
            flush=True,
        )

        return result

    # ── Batch convenience ────────────────────────────────────────────────

    def match_batch(self, faces: List[np.ndarray]) -> List[Match]:
        """Process a list of face crops (e.g. all detections in one frame)."""
        return [self.match(f) for f in faces]